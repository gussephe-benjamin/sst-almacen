# --- Base de datos y servidor ---
DATABASE_URL=postgres://sst:sst@localhost:5433/sst?sslmode=disable
# Secreto para firmar las sesiones: valor aleatorio de al menos 32 caracteres.
JWT_SECRET=genera-un-valor-aleatorio-de-al-menos-32-caracteres
UPLOAD_DIR=./data/uploads
PORT=8081
# production: valida la configuración al iniciar. Usa COOKIE_SECURE=true cuando sirvas la app por HTTPS.
APP_ENV=production
COOKIE_SECURE=false
# Carpeta del frontend compilado (npm run build). Si existe, la API también sirve la aplicación.
STATIC_DIR=../frontend/dist

# --- Cuentas que deben existir siempre ---
# Se crean al iniciar la API si el DNI aún no existe; si ya existe, no se modifica.
# Formato: DNI|contraseña|Nombres|Puesto|Área|Correo|Celular   (varias cuentas separadas por ;)
# Puesto y Área son opcionales (el área debe existir: Almacén A, Almacén B, Zona de carga,
# Patio de maniobras, Oficinas, Mantenimiento, Administración, SST, Calidad, Dirección).
# Las cuentas de administrador SOLO se crean aquí (contraseña de al menos 10 caracteres).
# El administrador crea el resto de cuentas desde la app, en "Cuentas y puestos".

ACCOUNTS_ADMIN=10000001|contraseña-de-10-o-mas-caracteres|Administrador del sistema|Administrador del sistema|Dirección

# Opcional: cuentas fijas de otros roles. Ejemplo:
# ACCOUNTS_SST=12345678|contraseña-segura|Nombre Apellido|Jefe de SST|SST|correo@empresa.com|999 999 999
ACCOUNTS_SST=
ACCOUNTS_TRABAJADOR=
ACCOUNTS_MANTENIMIENTO=
ACCOUNTS_ADMINISTRACION=
